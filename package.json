{
  "name": "pipedeck",
  "private": true,
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "dev": "pnpm --filter @pipedeck/web dev",
    "build": "pnpm --filter @pipedeck/web build",
    "test": "pnpm --filter @pipedeck/web test",
    "gen:api": "pnpm --filter @pipedeck/web gen:api",
    "sidecar:build": "powershell -ExecutionPolicy Bypass -File scripts/build-sidecar.ps1",
    "cli:build": "powershell -ExecutionPolicy Bypass -File scripts/build-cli.ps1",
    "desktop:dev": "pnpm sidecar:build && pnpm --filter @pipedeck/desktop tauri dev",
    "desktop:build": "pnpm sidecar:build && pnpm cli:build && pnpm --filter @pipedeck/desktop tauri build"
  }
}
